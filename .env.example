# docker compose -f docker-compose.storybook.yml 会自动读取同目录的 .env。
# 复制成 .env 后填写：cp .env.example .env

# Claude 订阅令牌（必填，手绘故事动画用它画动画）。
# 在已登录 Claude Code 的电脑上执行 `claude setup-token`，把输出的令牌贴在这里。
CLAUDE_CODE_OAUTH_TOKEN=

# 豆包语音 API Key（可选）。留空时故事动画使用 WebUI 选择的声音（例如 Edge TTS）。
DOUBAO_TTS_API_KEY=

# 端口监听地址。默认只允许本机访问；要让局域网其他设备访问改成 0.0.0.0。
# WebUI 没有登录验证，只在可信网络中开放。
MPT_BIND_ADDRESS=127.0.0.1
